<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DiscordRPC-NativeAOT</AssemblyName>
    <RootNamespace>DiscordRPC</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>

    <!-- NuGet -->
    <PackageId>Froststrap.DiscordRPC</PackageId>
    <Version>1.0.0</Version>
    <Authors>Froststrap; Invra</Authors>
    <Company>Froststrap</Company>
    <Copyright>Copyright (c) Lachee, Froststrap</Copyright>
    <Description>A high-performance, Native AOT compatible Discord Rich Presence client for .NET 10.0. Built with System.Text.Json Source Generation, zero reflection, and zero external dependencies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>discord;rpc;rich-presence;native-aot;aot;json-source-gen;dotnet10</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Froststrap/DiscordRPC-NativeAOT</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Froststrap/DiscordRPC-NativeAOT</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Initial Froststrap release of DiscordRPC-NativeAOT.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
